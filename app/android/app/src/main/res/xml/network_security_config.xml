<?xml version="1.0" encoding="utf-8"?>
<!-- Encrypted connections only, except the radiojar stations (Quran Radio from Cairo and from
     Saudi Arabia), whose https address answers with a plain http one for the audio itself. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">radiojar.com</domain>
    </domain-config>
</network-security-config>
