<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: the verse of the day, from the app (WidgetBridge.verse). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp"
    android:background="@drawable/widget_bg"
    android:layoutDirection="locale">

    <TextView
        android:id="@+id/v_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFF2D58A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:text="@string/verse_title" />

    <TextView
        android:id="@+id/v_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#FFF5F1E6"
        android:textSize="17sp"
        android:lineSpacingMultiplier="1.25"
        android:maxLines="6"
        android:ellipsize="end"
        android:text="@string/verse_empty" />

    <TextView
        android:id="@+id/v_ref"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#B3F5F1E6"
        android:textSize="12sp" />
</LinearLayout>
