<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: a tasbih. Tap to count; change the dhikr or reset with the small buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg"
    android:layoutDirection="locale">

    <LinearLayout
        android:id="@+id/t_tap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/t_phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFF2D58A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/t_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF5F1E6"
            android:textSize="34sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/t_next"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="34dp"
            android:gravity="center"
            android:textColor="#CCF5F1E6"
            android:textSize="18sp"
            android:text="⇄" />

        <TextView
            android:id="@+id/t_reset"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="34dp"
            android:gravity="center"
            android:textColor="#CCF5F1E6"
            android:textSize="18sp"
            android:text="↺" />
    </LinearLayout>
</LinearLayout>
