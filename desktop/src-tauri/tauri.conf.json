{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muslim Activity",
  "version": "1.0.0",
  "identifier": "io.github.micro4tricks.muslimtodo",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "publisher": "micro4tricks-ai",
